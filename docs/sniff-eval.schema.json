{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sniff.dev/schemas/sniff-eval-response.schema.json",
  "title": "SniffEvalResponse",
  "description": "Structured answer the LLM must return when evaluating a sniff-diff delta for a page. A rigid schema lets the pipeline filter critical regressions automatically.",
  "type": "object",
  "required": ["page_url", "status", "score_change", "summary", "changes_evaluated"],
  "properties": {
    "page_url": {
      "type": "string",
      "description": "URL of the evaluated page."
    },
    "status": {
      "type": "string",
      "enum": ["IMPROVEMENT", "NEUTRAL", "REGRESSION_DETECTED"],
      "description": "Overall verdict for the delta."
    },
    "score_change": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100,
      "description": "Design/UX quality delta, -100 (heavy regression) to +100 (heavy improvement)."
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph human summary of the change and its impact."
    },
    "changes_evaluated": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_selector", "impact", "category", "reason"],
        "properties": {
          "node_selector": {
            "type": "string",
            "description": "Selector of the changed node, as emitted by sniff-diff."
          },
          "impact": {
            "type": "string",
            "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"]
          },
          "category": {
            "type": "string",
            "enum": [
              "ACCESSIBILITY",
              "LAYOUT_STABILITY",
              "VISUAL_HIERARCHY",
              "DESIGN_SYSTEM",
              "PERFORMANCE",
              "OTHER"
            ],
            "description": "Pillar affected: a11y contrast/ARIA, CLS/stability, hierarchy, design-system consistency, etc."
          },
          "reason": {
            "type": "string",
            "description": "Evidence-based explanation (e.g. 'contrast fell from 4.5:1 to 2.1:1')."
          },
          "measured": {
            "type": "object",
            "description": "Optional measured signals backing the reason — only values actually emitted by the tool (contrast.ratio/aa, aria.role/name, ax.role, uniformity deviation).",
            "properties": {
              "contrast_ratio": { "type": "number" },
              "contrast_aa": { "type": "string", "enum": ["pass", "fail", "unknown"] },
              "aria_role": { "type": "string" },
              "aria_name": { "type": "string" },
              "uniformity_deviation": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
